# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
NEXTAUTH_SECRET=random-32-char-string-here
NEXTAUTH_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key-here
SUPABASE_SERVICE_KEY=service-role-key-here

# AI Services
ELEVENLABS_API_KEY=elevenlabs-key
PEXELS_API_KEY=pexels-key
OPENAI_API_KEY=openai-key-for-analysis

# Cron Security
CRON_SECRET=random-secret-for-cron-job

# Optional
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app